---
/**
 * Inicio (es/en). Secuencia: header transparente → hero (foto + red ambiental) →
 * franja de capacidades → por qué trabajar con nosotros → trayectoria →
 * capacidades (mosaico) → observatorio (mapa-red + cifras) → proyectos destacados →
 * cierre de conversión (BaseLayout) → footer.
 */
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallButton from '@/components/CallButton.astro';
import Icon from '@/components/Icon.astro';
import NetworkMap from '@/components/NetworkMap.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Ticker from '@/components/Ticker.astro';
import Timeline from '@/components/Timeline.astro';
import { CV_PATH } from '@/config/site';
import { ROUTES, href, projectPath, t, withBase, type Lang } from '@/i18n';
import { block, getExperience, getPage, getProjects } from '@/lib/content';

import whyPhoto from '@/assets/photos/perfil oficial.jpeg';
import rightOfWayPhoto from '@/assets/photos/filosofia.jpeg';
import containmentPhoto from '@/assets/photos/autopista-maravatio-03.jpeg';
import negotiationPhoto from '@/assets/photos/autopista-sigloxxi-02.jpeg';
import riskPhoto from '@/assets/photos/autopista-guadalajara.jpeg';
import crisisPhoto from '@/assets/photos/autopista-maravatio-02.jpeg';
import relationsPhoto from '@/assets/photos/experiencia.jpeg';
import legalPhoto from '@/assets/photos/autopista-sigloxxi.jpeg';
import contractsPhoto from '@/assets/photos/perfil.jpeg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const page = await getPage(lang, 'home');
const experience = await getExperience(lang);
const projects = await getProjects(lang);
const infrastructure = projects.filter((p) => p.data.category === 'infrastructure');
const capabilitiesPage = projects.find((p) => p.data.translationKey === 'services');
if (!page.data.image || !capabilitiesPage) throw new Error('Falta contenido de Inicio.');

// Video opcional del hero: solo si existe src/assets/video/hero-loop.mp4 (ver README).
const videos = import.meta.glob<string>('/src/assets/video/hero-loop.mp4', {
  eager: true,
  query: '?url',
  import: 'default',
});
const heroVideo = Object.values(videos)[0];
const poster = heroVideo
  ? await getImage({ src: page.data.image, width: 1600, format: 'webp' })
  : undefined;

// Capacidades: cada bloque enlaza a su sección en la subpágina de Capacidades.
const capabilitiesUrl = withBase(projectPath(lang, capabilitiesPage.data.route));
const capabilityMeta = [
  { id: 'right-of-way', photo: rightOfWayPhoto, size: 'a' },
  { id: 'social-containment', photo: containmentPhoto, size: 'b' },
  { id: 'negotiation', photo: negotiationPhoto, size: 'c' },
  { id: 'risk', photo: riskPhoto, size: 'd' },
  { id: 'crisis', photo: crisisPhoto, size: 'e' },
  { id: 'public-relations', photo: relationsPhoto, size: 'f' },
  { id: 'legal-follow-up', photo: legalPhoto, size: 'g' },
  { id: 'contract-review', photo: contractsPhoto, size: 'h' },
] as const;
const capabilities = page.data.items.map((item, i) => {
  const meta = capabilityMeta[i];
  if (!meta) throw new Error('Hay más capacidades que fotos asignadas en HomeView.');
  return { ...item, ...meta, url: `${capabilitiesUrl}#${meta.id}` };
});

// Cifras verificables, calculadas del propio contenido del sitio.
const operators = new Set(infrastructure.map((p) => p.data.operator).filter(Boolean));
const figures = [
  { value: experience.length, label: block(page, 'figureRoles') },
  { value: infrastructure.length, label: block(page, 'figureProjects') },
  { value: capabilities.length, label: block(page, 'figureAreas') },
  { value: operators.size, label: block(page, 'figureOperators') },
];

// Leyenda del mapa: corredores con coordenadas públicas de referencia.
const W = lang === 'es' ? 'O' : 'W';
const coord = (lat: number, lon: number) =>
  `${lat.toFixed(2)}°N · ${Math.abs(lon).toFixed(2)}°${W}`;
const legendRefs = [
  { key: 'guadalajara', lat: 20.67, lon: -103.35 },
  { key: 'maravatio-zitacuaro', lat: 19.89, lon: -100.44 },
  { key: 'siglo-xxi', lat: 19.51, lon: -101.61 },
];
const legend = legendRefs.flatMap((ref) => {
  const project = infrastructure.find((p) => p.data.translationKey === ref.key);
  return project
    ? [
        {
          title: project.data.title,
          operator: project.data.operator,
          coords: coord(ref.lat, ref.lon),
          url: withBase(projectPath(lang, project.data.route)),
        },
      ]
    : [];
});
---

<BaseLayout
  lang={lang}
  title={page.data.title}
  description={page.data.description}
  path={ROUTES.home[lang]}
  alternates={ROUTES.home}
  current="home"
  image={page.data.image}
  imageAlt={page.data.imageAlt}
  overlayHeader
>
  {/* Hero a pantalla completa */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <Picture
        src={page.data.image}
        alt={page.data.imageAlt ?? ''}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
      {heroVideo && poster && (
        <video
          class="hero-video"
          src={heroVideo}
          poster={poster.src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          disablepictureinpicture
          aria-hidden="true"
        />
      )}
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="hero-network anim-fade" aria-hidden="true">
      <NetworkMap variant="ambient" lang={lang} idPrefix="hero-net" />
    </div>
    <div class="wrap hero-content">
      <p class="eyebrow anim-rise delay-1">{page.data.eyebrow}</p>
      <h1 id="hero-title" class="display hero-title anim-rise delay-2">
        {page.data.heading}
      </h1>
      <p class="hero-lead anim-rise delay-3">{page.data.lead}</p>
      <div class="hero-cta anim-rise delay-4">
        <CallButton lang={lang} label={t(lang, 'cta.book')} size="lg" primary />
        <p class="hero-note">{block(page, 'heroNote')}</p>
      </div>
    </div>
    <a class="scroll-cue" href="#why" aria-label={block(page, 'scrollLabel')}>
      <span class="scroll-track" aria-hidden="true">
        <span class="scroll-dot"></span>
      </span>
    </a>
  </section>

  {/* Franja de capacidades en movimiento */}
  <Ticker label={block(page, 'tickerLabel')} items={capabilities.map((c) => c.title)} />

  {/* Por qué trabajar con nosotros */}
  <section id="why" class="section why" aria-labelledby="why-title">
    <div class="wrap why-grid">
      <div class="why-text" data-reveal>
        <p class="eyebrow">{block(page, 'whyEyebrow')}</p>
        <h2 id="why-title" class="h2 strong">
          {block(page, 'whyTitle')}
        </h2>
        <p>{block(page, 'whyP1')}</p>
        <p>{block(page, 'whyP2')}</p>
      </div>
      <figure class="why-photo photo photo--frame" data-reveal>
        <Picture
          src={whyPhoto}
          alt={block(page, 'whyImageAlt')}
          formats={['avif', 'webp']}
          width={1200}
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 64rem) 40vw, 100vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  {/* Trayectoria */}
  <section class="section surface" aria-labelledby="trajectory-title">
    <div class="wrap trajectory-grid">
      <div class="trajectory-head" data-reveal>
        <p class="eyebrow">{block(page, 'trajectoryEyebrow')}</p>
        <h2 id="trajectory-title" class="h2 strong">
          {block(page, 'trajectoryTitle')}
        </h2>
        <p class="muted">{block(page, 'trajectoryText')}</p>
        <a class="link" href={href(lang, 'experience')}>
          {t(lang, 'experience.view')}
          <Icon name="arrow" class="arrow" />
        </a>
        <a class="link" href={withBase(CV_PATH)} download>
          {t(lang, 'experience.cv')}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
      <Timeline items={experience} />
    </div>
  </section>

  {/* Capacidades: mosaico editorial de tamaños distintos */}
  <section class="section" aria-labelledby="capabilities-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{block(page, 'servicesEyebrow')}</p>
          <h2 id="capabilities-title" class="h2 strong">
            {block(page, 'servicesTitle')}
          </h2>
          <p class="section-text">{block(page, 'servicesText')}</p>
        </div>
        <a class="link" href={capabilitiesUrl}>
          {block(page, 'servicesLink')}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
      <ul role="list" class="mosaic">
        {capabilities.map((cap, i) => (
          <li class={`tile tile--${cap.size}`} data-reveal>
            <a href={cap.url} class="tile-link">
              <span class="tile-media" aria-hidden="true">
                <Picture
                  src={cap.photo}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes={
                    cap.size === 'a'
                      ? '(min-width: 64rem) 60vw, 100vw'
                      : '(min-width: 64rem) 40vw, 100vw'
                  }
                  loading="lazy"
                />
              </span>
              <span class="tile-body">
                <span class="tile-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="tile-title">{cap.title}</span>
                <span class="tile-text">{cap.text}</span>
                <Icon name="arrow" class="arrow tile-arrow" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Observatorio: mapa-red de México + cifras verificables */}
  <section class="observatory on-primary" aria-labelledby="observatory-title">
    <div class="wrap obs-grid">
      <div class="obs-text" data-reveal>
        <p class="eyebrow">{block(page, 'observatoryEyebrow')}</p>
        <h2 id="observatory-title" class="h2 strong">
          {block(page, 'observatoryTitle')}
        </h2>
        <p class="lead">{block(page, 'observatoryText')}</p>

        <h3 class="obs-label">{block(page, 'legendTitle')}</h3>
        <ul role="list" class="legend">
          {legend.map((item) => (
            <li>
              <a href={item.url}>
                <span class="legend-dot" aria-hidden="true" />
                <span class="legend-title">{item.title}</span>
                <span class="legend-meta">
                  {item.operator} · {item.coords}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <figure class="obs-panel" data-reveal>
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
        <NetworkMap
          variant="full"
          lang={lang}
          idPrefix="obs-net"
          title={block(page, 'mapTitle')}
          desc={block(page, 'mapDesc')}
        />
      </figure>

      <dl class="readouts">
        {figures.map((f) => (
          <div class="readout" data-reveal>
            <dt class="readout-label">{f.label}</dt>
            <dd class="readout-value">
              <span data-count={f.value} aria-hidden="true">
                {f.value}
              </span>
              <span class="visually-hidden">{f.value}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="obs-note">{block(page, 'figuresNote')}</p>
    </div>
  </section>

  {/* Proyectos destacados */}
  <section class="section" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">{block(page, 'projectsEyebrow')}</p>
          <h2 id="projects-title" class="h2 strong">
            {block(page, 'projectsTitle')}
          </h2>
        </div>
        <a class="link" href={href(lang, 'projects')}>
          {block(page, 'projectsLink')}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
      <div class="featured">
        {infrastructure.map((project, i) => (
          <ProjectCard project={project} lang={lang} index={i} reverse={i % 2 === 1} />
        ))}
      </div>
    </div>
  </section>
  {/* Cierre de conversión: ContactCTA (BaseLayout) · Footer */}
</BaseLayout>

<style>
  .strong {
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    min-height: clamp(36rem, 100svh, 64rem);
    color: var(--on-primary);
    background: var(--primary);
    overflow: hidden;
    --focus: var(--accent-on-primary);
  }
  .hero-media,
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-overlay {
    z-index: -1;
  }
  .hero-media :global(picture),
  .hero-media :global(img),
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 35%;
  }
  .hero-media :global(img),
  .hero-video {
    filter: saturate(0.65) contrast(1.05);
  }
  .hero-video {
    position: absolute;
    inset: 0;
  }
  .hero-overlay {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--primary) 74%, transparent) 0%,
        color-mix(in srgb, var(--primary) 60%, transparent) 40%,
        color-mix(in srgb, var(--primary) 94%, transparent) 100%
      ),
      linear-gradient(90deg, color-mix(in srgb, var(--primary) 60%, transparent), transparent 70%);
  }
  .hero-network {
    position: absolute;
    z-index: -1;
    right: -6%;
    top: 10%;
    width: min(70%, 62rem);
    opacity: 0.55;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .hero-content {
    display: grid;
    gap: 1.5rem;
    padding-block: 9rem clamp(6rem, 12vh, 9rem);
  }
  .hero .eyebrow {
    color: var(--accent-on-primary);
  }
  .hero-title {
    font-weight: 600;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .hero-lead {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.4rem);
    line-height: 1.5;
    color: var(--on-primary);
    max-width: 46ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.5rem;
  }
  .hero-note {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--on-primary-soft);
  }
  .hero :global(.btn--primary) {
    background: var(--cta-on-primary);
    color: var(--on-cta-on-primary);
  }
  .delay-4 {
    animation-delay: 0.45s;
  }
  @media (max-width: 47.99rem) {
    .hero-network {
      width: 120%;
      right: -30%;
      top: 6%;
      opacity: 0.35;
    }
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 3.5rem;
  }
  .scroll-track {
    position: relative;
    width: 1px;
    height: 2.75rem;
    background: color-mix(in srgb, var(--on-primary) 35%, transparent);
    overflow: hidden;
  }
  .scroll-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 0.9rem;
    background: var(--accent-on-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-media :global(img),
    .hero-video {
      animation: kenburns 28s ease-in-out infinite alternate;
    }
    .scroll-dot {
      animation: scroll-dot 2.4s var(--ease) infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  /* Movimiento sutil: un acercamiento mayor recorta a las personas de la foto. */
  @keyframes kenburns {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.05) translate3d(-0.5%, -0.5%, 0);
    }
  }
  @keyframes scroll-dot {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(320%);
    }
  }

  /* ---------- Por qué trabajar con nosotros ---------- */
  .why-grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  .why-text {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
  }
  .why-text .h2 {
    margin-bottom: 0.5rem;
  }
  .why-text p:not(.eyebrow) {
    color: var(--ink-soft);
    font-size: 1.125rem;
  }
  /* Retrato completo: el marco sigue la proporción original de la foto (5:7). */
  .why-photo {
    aspect-ratio: 5 / 7;
    margin-right: 0.9rem;
    max-width: 30rem;
  }
  .why-photo :global(img) {
    object-position: 50% 20%;
  }
  @media (min-width: 64rem) {
    .why-grid {
      grid-template-columns: 7fr 5fr;
      gap: clamp(3rem, 7vw, 8rem);
    }
    .why-photo {
      margin-top: -2rem;
    }
  }

  /* ---------- Trayectoria ---------- */
  .trajectory-grid {
    display: grid;
    gap: 3rem;
  }
  .trajectory-head {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .trajectory-head .link {
    justify-self: start;
    margin-top: 0.5rem;
  }
  @media (min-width: 64rem) {
    .trajectory-grid {
      grid-template-columns: 5fr 7fr;
      gap: clamp(3rem, 7vw, 8rem);
    }
    .trajectory-head {
      position: sticky;
      top: 7rem;
    }
  }

  /* ---------- Encabezado de sección con enlace ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .section-head .h2 {
    margin-top: 1rem;
  }
  .section-text {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1.125rem;
  }

  /* ---------- Mosaico de capacidades (8 bloques de tamaños distintos) ---------- */
  .mosaic {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .tile {
    position: relative;
    min-height: 19rem;
  }
  .tile--a {
    min-height: 25rem;
  }
  .tile-link {
    position: relative;
    display: flex;
    height: 100%;
    min-height: inherit;
    overflow: hidden;
    color: var(--on-primary);
    background: var(--primary);
    text-decoration: none;
    --focus: var(--accent-on-primary);
  }
  .tile-link:focus-visible {
    outline-offset: -4px;
  }
  .tile-media {
    position: absolute;
    inset: 0;
  }
  .tile-media :global(picture),
  .tile-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile-media :global(img) {
    filter: saturate(0.65);
    transition: transform 1.1s var(--ease);
  }
  .tile-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--primary) 25%, transparent) 0%,
      color-mix(in srgb, var(--primary) 72%, transparent) 42%,
      color-mix(in srgb, var(--primary) 96%, transparent) 100%
    );
  }
  .tile-body {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: end;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .tile-num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent-on-primary);
  }
  .tile-num::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    margin-top: 0.75rem;
    background: var(--accent-on-primary);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .tile-title {
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .tile--a .tile-title {
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.75rem);
  }
  .tile-text {
    max-width: 36ch;
    color: var(--on-primary-soft);
  }
  .tile-body :global(.tile-arrow) {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.25rem;
    color: var(--accent-on-primary);
  }
  .tile-link:hover .tile-media :global(img),
  .tile-link:focus-visible .tile-media :global(img) {
    transform: scale(1.05);
  }
  .tile-link:hover .tile-num::after,
  .tile-link:focus-visible .tile-num::after {
    transform: scaleX(2.5);
  }
  .tile-link:hover :global(.tile-arrow) {
    transform: translateX(6px);
  }
  @media (min-width: 48rem) {
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: minmax(13rem, auto);
    }
    .tile {
      min-height: 0;
    }
    .tile--a {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }
    .tile--b {
      grid-column: 8 / span 5;
      grid-row: 1;
    }
    .tile--c {
      grid-column: 8 / span 5;
      grid-row: 2;
    }
    .tile--d {
      grid-column: 1 / span 5;
      grid-row: 3 / span 2;
    }
    .tile--e {
      grid-column: 6 / span 4;
      grid-row: 3 / span 2;
    }
    .tile--f {
      grid-column: 10 / span 3;
      grid-row: 3 / span 2;
    }
    .tile--g {
      grid-column: 1 / span 6;
      grid-row: 5;
    }
    .tile--h {
      grid-column: 7 / span 6;
      grid-row: 5;
    }
  }
  @media (min-width: 64rem) {
    .mosaic {
      grid-auto-rows: minmax(15rem, auto);
    }
  }
