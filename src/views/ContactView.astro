---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CallButton from '@/components/CallButton.astro';
import CopyButton from '@/components/CopyButton.astro';
import PhoneNumber from '@/components/PhoneNumber.astro';
import { ROUTES, type Lang } from '@/i18n';
import { block, getPage } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'contact');
---

<BaseLayout
  lang={lang}
  title={page.data.title}
  description={page.data.description}
  path={ROUTES.contact[lang]}
  alternates={ROUTES.contact}
  current="contact"
  closingCta={false}
>
  <section class="contact on-primary" aria-labelledby="contact-title">
    <div class="wrap grid">
      <div class="head">
        <p class="eyebrow anim-rise delay-1">{page.data.eyebrow}</p>
        <h1 id="contact-title" class="display title anim-rise delay-2">
          {page.data.heading}
        </h1>
        <p class="lead anim-rise delay-3">{page.data.lead}</p>
      </div>

      <div id="telefono" class="phone-card anim-rise delay-3" tabindex="-1">
        <h2 class="phone-title">{block(page, 'phoneTitle')}</h2>
        <p class="phone-big">
          <PhoneNumber />
        </p>
        <div class="actions">
          <CallButton lang={lang} size="lg" primary />
          <CopyButton lang={lang} id="contact-copy" />
        </div>
        <p class="reassure">{block(page, 'reassure')}</p>
        <p class="note">{block(page, 'privacyNote')}</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="wrap steps-grid">
      <h2 id="steps-title" class="h2">
        {block(page, 'stepsTitle')}
      </h2>
      <ol role="list" class="steps">
        {page.data.steps.map((s, i) => (
          <li class="step" data-reveal>
            <span class="step-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: clamp(4rem, 2.5rem + 6vw, 8rem);
  }
  .grid {
    display: grid;
    gap: 3rem;
  }
  .head {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .title {
    font-weight: 600;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .phone-card {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid color-mix(in srgb, var(--on-primary) 22%, transparent);
    border-top: 3px solid var(--cta-on-primary);
  }
  .phone-card:focus {
    outline: none;
  }
  .phone-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-on-primary);
  }
  .phone-big {
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3.25rem);
    font-weight: 300;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .reassure {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent-on-primary);
  }
  .note {
    font-size: 0.875rem;
    color: var(--on-primary-soft);
    max-width: 44ch;
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: 6fr 5fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .steps-grid {
    display: grid;
    gap: 2.5rem;
  }
  .steps {
    margin: 0;
    display: grid;
    gap: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.4rem 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .step-num {
    grid-row: span 2;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-strong);
    padding-top: 0.2rem;
  }
  @media (min-width: 64rem) {
    .steps-grid {
      grid-template-columns: 4fr 8fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
</style>
