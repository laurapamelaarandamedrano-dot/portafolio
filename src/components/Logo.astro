---
/**
 * Logotipo: monograma enmarcado + nombre en dos líneas.
 * Un solo color (currentColor) y una sola tipografía, para que funcione igual
 * sobre fondo claro, sobre el hero oscuro y en el pie de página.
 */
import { PERSON_NAME } from '@/config/site';

interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;

// "Salvador J. Vazquez Villa" → "Salvador J." / "Vazquez Villa" · monograma "SV"
const words = PERSON_NAME.split(' ');
const line1 = words.slice(0, 2).join(' ');
const line2 = words.slice(2).join(' ');
const initials = `${words[0]?.[0] ?? ''}${words[2]?.[0] ?? ''}`;
---

<span class:list={['logo', `logo--${size}`]}>
  <span class="mark" aria-hidden="true">{initials}</span>
  <span class="rule" aria-hidden="true"></span>
  <span class="name">
    <span>{line1}</span>{' '}<span>{line2}</span>
  </span>
</span>

<style>
  .logo {
    --mark: 2.6rem;
    --text: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    color: currentColor;
  }
  .logo--lg {
    --mark: 3.25rem;
    --text: 0.95rem;
  }
  .mark {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: var(--mark);
    height: var(--mark);
    border: 1px solid currentColor;
    font-size: calc(var(--mark) * 0.36);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-indent: 0.08em;
    line-height: 1;
  }
  /* Segundo marco desplazado: el mismo motivo de las fotos del sitio. */
  .mark::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid currentColor;
    opacity: 0.35;
  }
  .rule {
    flex: none;
    width: 1px;
    height: calc(var(--mark) * 0.8);
    background: currentColor;
    opacity: 0.35;
  }
  .name {
    display: grid;
    font-size: var(--text);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
