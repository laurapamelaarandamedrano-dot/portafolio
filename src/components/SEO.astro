---
/**
 * Metadatos: title, description, canonical, hreflang, Open Graph y JSON-LD (Person).
 * El teléfono NO se incluye en metadatos ni en JSON-LD.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroPhoto from '@/assets/photos/hero.jpeg';
import { PERSON_NAME } from '@/config/site';
import { DEFAULT_LANG, HREFLANG, LANGS, t, withBase, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Record<Lang, string>;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
  noindex?: boolean;
}
const {
  lang,
  title,
  description,
  path,
  alternates,
  image,
  imageAlt,
  noindex = false,
} = Astro.props;

const site = Astro.site;
if (!site) throw new Error('Configura `site` en astro.config.mjs (SITE_URL).');
const abs = (p: string) => new URL(withBase(p), site).href;

const canonical = abs(path);
const fullTitle = title === PERSON_NAME ? title : `${title} · ${PERSON_NAME}`;
const og = await getImage({
  src: image ?? heroPhoto,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 80,
});
const ogImage = new URL(og.src, site).href;

const personId = `${abs(alternates[DEFAULT_LANG])}#person`;
const knowsAbout =
  lang === 'es'
    ? [
        'Liberación de derecho de vía',
        'Contención social',
        'Negociación de alto nivel',
        'Manejo de riesgos',
        'Control de crisis',
        'Relaciones públicas',
      ]
    : [
        'Right-of-way acquisition',
        'Social conflict containment',
        'High-stakes negotiation',
        'Risk management',
        'Crisis management',
        'Public relations',
      ];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: PERSON_NAME,
      url: abs(alternates[DEFAULT_LANG]),
      knowsAbout,
    },
    {
      '@type': 'WebSite',
      '@id': `${abs('/')}#website`,
      url: abs('/'),
      name: PERSON_NAME,
      inLanguage: LANGS.map((l) => HREFLANG[l]),
      about: { '@id': personId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: HREFLANG[lang],
      isPartOf: { '@id': `${abs('/')}#website` },
      about: { '@id': personId },
    },
  ],
};
// Escapa "<" para que el JSON no pueda cerrar la etiqueta <script>.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex &&
  LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={abs(alternates[l])} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={abs(alternates[DEFAULT_LANG])} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={PERSON_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={t(lang, 'meta.ogLocale')} />
{LANGS.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={t(l, 'meta.ogLocale')} />
))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content="summary_large_image" />

{!noindex && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
