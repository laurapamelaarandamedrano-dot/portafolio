---
/** Íconos lineales propios (SVG en línea, decorativos). Sin emojis ni librerías. */
interface Props {
  name: 'arrow' | 'phone' | 'copy' | 'menu' | 'close';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === 'phone' && (
    <path d="M6.6 3.5h2.6l1.5 4-2 1.4a12.5 12.5 0 0 0 6.4 6.4l1.4-2 4 1.5v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />
  )}
  {name === 'copy' && (
    <>
      <rect x="8.5" y="8.5" width="11" height="11" rx="1" />
      <path d="M15.5 8.5V5.5a1 1 0 0 0-1-1h-9a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h3" />
    </>
  )}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
