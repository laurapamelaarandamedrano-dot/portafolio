---
import PhoneNumber from './PhoneNumber.astro';
import { PERSON_NAME } from '@/config/site';
import { NAV, href, t, type Lang } from '@/i18n';
import { encodeForClient, getPhone } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { phoneE164 } = await getPhone();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="id">
        <p class="name">{PERSON_NAME}</p>
        <p class="tagline">{t(lang, 'footer.tagline')}</p>
      </div>
      <p class="phone">
        <span class="label">{t(lang, 'cta.phoneLabel')}</span>
        <a href={`${href(lang, 'contact')}#telefono`} data-tel={encodeForClient(phoneE164)}>
          <PhoneNumber />
        </a>
      </p>
      <nav aria-label={t(lang, 'a11y.footerNav')}>
        <ul role="list" class="links">
          <li>
            <a href={href(lang, 'home')}>{t(lang, 'nav.home')}</a>
          </li>
          {NAV.map((key) => (
            <li>
              <a href={href(lang, key)}>{t(lang, `nav.${key}`)}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <p>
        © {year} {PERSON_NAME}. {t(lang, 'footer.rights')}
      </p>
      <p>{t(lang, 'footer.noTracking')}</p>
      <p>
        <a href={href(lang, 'privacy')}>{t(lang, 'nav.privacy')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding-block: 4rem 2rem;
    font-size: 0.9375rem;
  }
  .top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .name {
    font-size: 1.35rem;
    font-weight: 300;
    letter-spacing: -0.01em;
  }
  .tagline {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .phone {
    display: grid;
    gap: 0.25rem;
  }
  .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .phone a {
    font-size: 1.25rem;
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .phone a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.3em;
  }
  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 1.5rem;
    margin: 0;
  }
  .links a,
  .bottom a {
    display: inline-block;
    padding-block: 0.4rem;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .links a:hover,
  .bottom a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  @media (min-width: 52rem) {
    .top {
      grid-template-columns: 5fr 3fr 4fr;
      align-items: start;
    }
  }
</style>
