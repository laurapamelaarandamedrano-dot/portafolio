{
  "name": "salvador-j-vazquez-villa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio personal de Salvador J. Vazquez Villa (Astro, estático, es-MX / en).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/strip-exif.mjs && node scripts/check-contrast.mjs && node scripts/gen-headers.mjs",
    "build": "astro check && astro build",
    "postbuild": "node scripts/verify-dist.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:dist": "node scripts/verify-dist.mjs",
    "photos:strip": "node scripts/strip-exif.mjs",
    "photos:check": "node scripts/strip-exif.mjs --check",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1"
  }
}
